# Auth / JWT (required in production)
# JWT_SECRET=replace-with-a-long-random-secret
# JWT_TTL_HOURS=24

# Frontend URL used for OAuth redirects after social sign-in
# FRONTEND_URL=https://panel.dorian.center

# Google OAuth (enable Sign in with Google)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URL exactly.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=https://api.example.com/api/v1/auth/oauth/google/callback

# GitHub OAuth (enable Sign in with GitHub)
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL must match GITHUB_REDIRECT_URL exactly.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URL=https://api.example.com/api/v1/auth/oauth/github/callback

# Enterprise SSO via generic OIDC (Okta, Entra ID, Keycloak, Google Workspace, etc.)
# Redirect URI must match SSO_OIDC_REDIRECT_URL exactly.
# SSO_OIDC_ISSUER=https://login.microsoftonline.com/{tenant-id}/v2.0
# SSO_OIDC_CLIENT_ID=
# SSO_OIDC_CLIENT_SECRET=
# SSO_OIDC_REDIRECT_URL=https://api.example.com/api/v1/auth/oauth/sso/callback
# SSO_OIDC_SCOPES=openid email profile

# ACME / Let's Encrypt (required for Cloudflare DNS-01)
ACME_CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
ACME_CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
ACME_CLOUDFLARE_RECORD_ID=your_cloudflare_txt_record_id

# Optional ACME overrides
# ACME_EMAIL=ssl@dorian.center
# ACME_DNS_PROVIDER=cloudflare
# ACME_DNS_ALIAS=acme-validation.dorian.center
# ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
# ACME_ACCOUNT_KEY_PATH=data/acme-account.pem

# Other DNS providers (optional)
# ACME_RFC2136_NAMESERVER=
# ACME_RFC2136_TSIG_KEY=
# ACME_RFC2136_TSIG_SECRET=
# ACME_HTTPREQ_ENDPOINT=
# ACME_HTTPREQ_USERNAME=
# ACME_HTTPREQ_PASSWORD=
