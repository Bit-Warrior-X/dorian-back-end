# ACME / Let's Encrypt (required for Cloudflare DNS-01)
ACME_CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
ACME_CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
ACME_CLOUDFLARE_RECORD_ID=your_cloudflare_txt_record_id

# Optional ACME overrides
# ACME_EMAIL=ssl@dorian.center
# ACME_DNS_PROVIDER=cloudflare
# ACME_DNS_ALIAS=acme-validation.dorian.center
# ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
# ACME_ACCOUNT_KEY_PATH=data/acme-account.pem

# Other DNS providers (optional)
# ACME_RFC2136_NAMESERVER=
# ACME_RFC2136_TSIG_KEY=
# ACME_RFC2136_TSIG_SECRET=
# ACME_HTTPREQ_ENDPOINT=
# ACME_HTTPREQ_USERNAME=
# ACME_HTTPREQ_PASSWORD=
